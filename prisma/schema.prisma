generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      String // "BUYER" | "SELLER" | "ADMIN"
  hotels    Hotel[]
  bookings  Booking[]
  createdAt DateTime @default(now())
}

model Hotel {
  id           String    @id @default(cuid())
  name         String
  city         String
  country      String
  description  String
  pricePerNight Int // stored in whole currency units (e.g. INR)
  currency     String    @default("INR")
  rating       Float     @default(0)
  imageUrl     String
  amenities    String // comma-separated list, kept simple for SQLite
  roomsTotal   Int       @default(1)
  published    Boolean   @default(true)

  // Hotel details: contact + payout info
  contactEmail      String @default("")
  contactPhone      String @default("")
  bankAccountHolder String @default("")
  bankAccountNumber String @default("")
  bankIfsc          String @default("")
  bankName          String @default("")

  // Location + Google Maps
  latitude  Float?
  longitude Float?

  // Meal plans on offer, comma-separated (e.g. "Room Only,Breakfast Included,Half Board")
  mealPlans String @default("")

  owner          User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId        String
  roomCategories RoomCategory[]
  bookings       Booking[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([city])
  @@index([ownerId])
}

model RoomCategory {
  id            String    @id @default(cuid())
  hotel         Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  hotelId       String
  name          String
  totalRooms    Int       @default(1)
  pricePerNight Int
  description   String    @default("")
  photos        String    @default("") // comma-separated URLs, category-wise
  bookings      Booking[]
  createdAt     DateTime  @default(now())

  @@index([hotelId])
}

model Booking {
  id             String        @id @default(cuid())
  hotel          Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  hotelId        String
  guest          User          @relation(fields: [guestId], references: [id], onDelete: Cascade)
  guestId        String
  guestName      String
  email          String
  checkIn        DateTime
  checkOut       DateTime
  guests         Int           @default(1)
  nights         Int
  total          Int
  status         String        @default("CONFIRMED") // CONFIRMED | CANCELLED
  mealPlan       String        @default("")
  roomCategory   RoomCategory? @relation(fields: [roomCategoryId], references: [id], onDelete: SetNull)
  roomCategoryId String?
  createdAt      DateTime      @default(now())

  @@index([hotelId])
  @@index([guestId])
  @@index([roomCategoryId])
}
