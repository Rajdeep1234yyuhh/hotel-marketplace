# Vercel Blob — auto-added when you connect a Blob store in Vercel Storage tab
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxxxx"

# Firebase Admin SDK — from Firebase Console > Project Settings > Service
# Accounts > Generate new private key. Paste the downloaded JSON's fields
# below. Keep the \n escapes literal in FIREBASE_PRIVATE_KEY — src/lib/firebase-admin.ts
# converts them back to real newlines at runtime.
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"

# Google OAuth client (from Google Cloud Console) — used directly by
# NextAuth's Google provider. Its callback URL is:
#   {NEXTAUTH_URL}/api/auth/callback/google
# Add that exact URL (with your real domain once deployed) to this OAuth
# client's "Authorised redirect URIs" in Google Cloud Console.
GOOGLE_CLIENT_ID="1234567890-abcdefghijklmnopqrstuvwxyz123456.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# NextAuth — generate a real secret with: openssl rand -base64 32
# (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
# NEXTAUTH_URL must match wherever the app is actually running.
NEXTAUTH_SECRET="replace-with-a-real-random-value"
NEXTAUTH_URL="http://localhost:3000"
