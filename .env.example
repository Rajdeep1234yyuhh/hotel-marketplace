# PostgreSQL connection string (pooled) — from Neon / Supabase / Vercel Postgres
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Direct (non-pooled) connection for Prisma migrations
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Vercel Blob — create a store in your Vercel project dashboard and paste the token here
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
